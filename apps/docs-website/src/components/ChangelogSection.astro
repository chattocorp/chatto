---
import { HIGHLIGHTS } from '../../../../tools/changelog.mjs';

interface Props {
  title: string;
  id: string;
  /** Each note is HTML rendered by the changelog collection. */
  notes: string[];
}

const { id, title, notes } = Astro.props;
const folded = title === 'Smaller changes';
const Container = folded ? 'details' : 'div';
---

<Container class:list={{ 'changelog-highlights': title === HIGHLIGHTS }}>
  {folded ? <summary id={id}>{title} ({notes.length})</summary> : <h2 id={id}>{title}</h2>}
  <ul>
    {notes.map((note) => <li set:html={note} />)}
  </ul>
</Container>

<style>
  .changelog-highlights {
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-accent-low), transparent 30%);
  }

  .changelog-highlights h2 {
    margin: 0;
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .changelog-highlights li {
    font-weight: 600;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>
