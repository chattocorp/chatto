{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatto.chat/schema/interchange/v1/event.schema.json",
  "description": "One historical fact or final state snapshot. File order is authoritative; snapshots have no invented occurrence time.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "type": {
      "enum": [
        "message.posted",
        "message.edited",
        "message.deleted",
        "message.snapshot",
        "reaction.added",
        "reaction.removed",
        "thread.created",
        "room.member_joined",
        "room.member_left",
        "room.membership_snapshot",
        "room.name_changed",
        "room.topic_changed",
        "room.purpose_changed",
        "room.archived",
        "room.unarchived"
      ]
    },
    "room_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "actor_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/nullableTimestamp"
    },
    "data": {
      "type": "object"
    }
  },
  "required": ["id", "type", "room_id", "actor_id", "occurred_at", "data"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "message.posted"
        },
        "data": {
          "type": "object",
          "properties": {
            "message_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "author_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "thread_id": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reply_to": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "content": {
              "$ref": "common.schema.json#/$defs/content"
            }
          },
          "required": ["message_id", "author_id", "thread_id", "reply_to", "content"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.edited"
        },
        "data": {
          "type": "object",
          "properties": {
            "message_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "content": {
              "$ref": "common.schema.json#/$defs/content"
            }
          },
          "required": ["message_id", "content"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.deleted"
        },
        "data": {
          "type": "object",
          "properties": {
            "message_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": ["message_id"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.snapshot"
        },
        "data": {
          "type": "object",
          "properties": {
            "message_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "author_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "thread_id": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reply_to": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "content": {
              "$ref": "common.schema.json#/$defs/content"
            },
            "created_at": {
              "$ref": "common.schema.json#/$defs/nullableTimestamp"
            },
            "edited_at": {
              "$ref": "common.schema.json#/$defs/nullableTimestamp"
            },
            "deleted_at": {
              "$ref": "common.schema.json#/$defs/nullableTimestamp"
            },
            "reactions": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/reaction"
              }
            }
          },
          "required": [
            "message_id",
            "author_id",
            "thread_id",
            "reply_to",
            "content",
            "created_at",
            "edited_at",
            "deleted_at",
            "reactions"
          ],
          "additionalProperties": false
        },
        "occurred_at": {
          "type": "null"
        },
        "actor_id": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "reaction.added"
        },
        "data": {
          "type": "object",
          "properties": {
            "message_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "user_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "emoji": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["message_id", "user_id", "emoji"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "reaction.removed"
        },
        "data": {
          "type": "object",
          "properties": {
            "message_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "user_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "emoji": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["message_id", "user_id", "emoji"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "thread.created"
        },
        "data": {
          "type": "object",
          "properties": {
            "root_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": ["root_id"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "room.member_joined"
        },
        "data": {
          "type": "object",
          "properties": {
            "user_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "reactions": {
              "description": "Final source reactions on this membership event; reaction times are unknown.",
              "type": "array",
              "items": {"$ref": "common.schema.json#/$defs/reaction"}
            }
          },
          "required": ["user_id"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "room.member_left"
        },
        "data": {
          "type": "object",
          "properties": {
            "user_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "reactions": {
              "description": "Final source reactions on this membership event; reaction times are unknown.",
              "type": "array",
              "items": {"$ref": "common.schema.json#/$defs/reaction"}
            }
          },
          "required": ["user_id"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "room.membership_snapshot"
        },
        "data": {
          "type": "object",
          "properties": {
            "user_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "uniqueItems": true
            }
          },
          "required": ["user_ids"],
          "additionalProperties": false
        },
        "occurred_at": {
          "type": "null"
        },
        "actor_id": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "room.name_changed"
        },
        "data": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "room.topic_changed"
        },
        "data": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "room.purpose_changed"
        },
        "data": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "room.archived"
        },
        "data": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "room.unarchived"
        },
        "data": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "occurred_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  ]
}
