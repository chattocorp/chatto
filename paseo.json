{
  "worktree": {
    "setup": "mise trust && mise setup",
    "teardown": "docker compose down -v"
  },
  "scripts": {
    "compose": {
      "command": "exec docker compose up --build"
    },
    "compose-watch": {
      "command": "exec docker compose up --build --watch"
    }
  },
  "metadataGeneration": {
    "branchName": {
      "instructions": "Use conventional commit branch prefixes, eg. fix/, feat/, perf/ etc."
    }
  }
}
