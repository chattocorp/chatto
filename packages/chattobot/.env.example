CHATTO_URL=http://localhost:8080
CHATTO_API_KEY=
# Required: the model, as provider/model.
CHATTO_AGENT_MODEL=
# Optional reasoning effort: off, minimal, low, medium, high, xhigh, or max.
# CHATTO_AGENT_THINKING=medium
# Shared by all models that use openrouter/. No Pi login required.
# Restart the bot after changing .env. An existing shell variable takes precedence.
# OPENROUTER_API_KEY=
# Optional: respond only to this exact Chatto user ID (not a display name).
# CHATTO_ALLOWED_USER_ID=U...
# Optional: classify new top-level posts in these rooms for automatic report intake.
# Use stable room IDs, separated by commas; empty keeps mention/reply-only room behavior.
# The model provider receives these posts even without a ping, plus attachment MIME types.
# CHATTO_AUTO_ENGAGE_ROOM_IDS=R...,R...
# Chatto user IDs of maintainers, separated by commas. Only maintainers can ask
# the bot to change GitHub, start/resume an investigation, or create/start work in Paseo.
# CHATTO_MAINTAINER_USER_IDS=U...,U...
# Optional Chatto login to @mention when a report needs maintainer input.
# This is a contact only; authorization still uses CHATTO_MAINTAINER_USER_IDS.
# The contact must be a member of the room for the mention to be delivered.
# CHATTO_MAINTAINER_NAME=maintainer
# Optional GitHub access through a GitHub App, for one repository (see README).
# GitHub receives each command and the host's IP address.
# CHATTO_GITHUB_APP_CLIENT_ID=Iv23li...
# CHATTO_GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/app.private-key.pem
# CHATTO_GITHUB_REPOSITORY=owner/repo
# Optional code investigation in a checkout of the Chatto source. Keep it current
# yourself. The investigator's model provider receives the code that it reads.
# CHATTO_SOURCE_DIRECTORY=/absolute/path/to/chatto
# CHATTO_INVESTIGATION_MODEL=
# CHATTO_INVESTIGATION_THINKING=medium
# Optional Paseo workspace creation. The repository path is on the Paseo host.
# Paseo receives the workspace title, branch, repository path, and bot host IP.
# Local desktop daemon uses ws://; use wss:// for a remote endpoint with TLS.
# CHATTO_PASEO_URL=ws://127.0.0.1:6767/ws
# CHATTO_PASEO_PASSWORD=
# CHATTO_PASEO_REPOSITORY_PATH=/absolute/path/to/chatto
# Optional implementation agent. Without a model, only workspace creation is available.
# Use a provider/model supported by your Paseo daemon, not the conversation model.
# For example: codex/gpt-6.1-sol or claude/claude-opus-5-5.
# List current model IDs with: paseo provider models codex (or claude).
# The coding provider receives the implementation brief, evidence, and code it reads.
# CHATTO_PASEO_AGENT_MODEL=provider/model
# Optional provider permission mode. Omit to use the provider default.
# CHATTO_PASEO_AGENT_MODE=
# Optional web search (Tavily) and page reading (Cloudflare Browser Run).
# Tavily receives search queries; Cloudflare receives page URLs. Both are paid services.
# CHATTO_TAVILY_API_KEY=tvly-...
# CHATTO_CLOUDFLARE_ACCOUNT_ID=
# CHATTO_CLOUDFLARE_API_TOKEN=
