package web

import (
	"github.com/chattocorp/chatto/authling/internal/accounts"
	"github.com/chattocorp/chatto/authling/internal/authorizations"
	"github.com/chattocorp/chatto/authling/internal/oidcprovider"
	"github.com/chattocorp/chatto/authling/internal/sessions"
	"github.com/chattocorp/chatto/authling/internal/web/ui"
	"net/url"
	"slices"
	"strconv"
	"time"
)

templ layout(title, signedInAs string) {
	@pageLayout(title, signedInAs, false) {
		{ children... }
	}
}

templ pageLayout(title, signedInAs string, wide bool, administrator ...bool) {
	@documentLayout(title, signedInAs, wide, false, administrator...) {
		{ children... }
	}
}

// documentLayout centers focused tasks in the space below the header. Wide
// pages own their panels; consent retains its compact authorization shell.
templ documentLayout(title, signedInAs string, wide, consent bool, administrator ...bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			@templ.Raw("<style>" + initialCanvasCSS + "</style>")
			if siteFromContext(ctx).Description != "" {
				<meta name="description" content={ siteFromContext(ctx).Description }/>
			}
			<title>{ sitePageTitle(ctx, title) }</title>
			<link rel="preload" href={ browserAssets.url("ibm-plex-sans-latin-wght-normal.woff2") } as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="stylesheet" href={ browserAssets.url("app.css") }/>
			if !consent {
				<script type="module" src={ browserAssets.url("app.js") }></script>
			}
		</head>
		<body class="flex min-h-dvh flex-col" hx-boost={ strconv.FormatBool(!consent) } hx-history="false">
			<a class="skip-link" href="#main-content">Skip to content</a>
			<header class="site-header">
				<div class={ "mx-auto flex flex-wrap items-center justify-between gap-4 px-4 py-2 sm:px-8", templ.KV("max-w-5xl", !consent), templ.KV("max-w-lg", consent) }>
					<a class="site-brand" href="/">
						<span class="iconify uil--shield-check shrink-0 text-2xl text-muted" aria-hidden="true"></span>
						<span class="min-w-0 break-words">{ siteFromContext(ctx).Name }</span>
					</a>
					if signedInAs != "" {
						<nav class="flex flex-wrap items-center gap-3" aria-label="Account navigation">
						if len(administrator) > 0 && administrator[0] {
								<a class="button button-secondary button-compact" href="/admin"
									if title == "Administration" {
										aria-current="page"
									}
								>Administration</a>
						}
						<a class="account-link" href="/account" aria-label={ "Signed in as " + signedInAs + ". View your account." }>
							<span class="iconify uil--user-circle shrink-0 text-xl" aria-hidden="true"></span>
							<span class="hidden max-w-56 truncate sm:block" title={ signedInAs }>{ signedInAs }</span>
							<span class="sm:hidden">Account</span>
						</a>
						</nav>
					}
				</div>
			</header>
			<main id="main-content" tabindex="-1" class={ templ.KV("focus-main", !wide && !consent), templ.KV("page-main page-main-wide", wide), templ.KV("mx-auto w-full max-w-lg px-5 py-5 sm:px-8", consent) }>
				<div class={ "min-w-0 wrap-anywhere", templ.KV("focus-card", !wide && !consent) }>
					{ children... }
				</div>
			</main>
		</body>
	</html>
}

templ loginPage(message, oidcRequest, returnPath string) {
	@layout("Sign in", "") {
		@ui.Heading("Sign in") {
			<p>Sign in to { siteFromContext(ctx).Name } with your email address and password.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/login" hx-boost={ strconv.FormatBool(oidcRequest == "") } hx-push-url="true">
			if oidcRequest != "" {
				<input type="hidden" name="oidc_request" value={ oidcRequest }/>
			}
			if returnPath != "" {
				<input type="hidden" name="return_to" value={ returnPath }/>
			}
			@ui.Field("email", "Email address", "", templ.Attributes{"type": "email", "name": "email", "autocomplete": "email", "autofocus": true, "required": true})
			@ui.Field("password", "Password", "", templ.Attributes{"type": "password", "name": "password", "autocomplete": "current-password", "maxlength": "1024", "required": true})
			<button class="button button-primary w-full" type="submit">Sign in</button>
		</form>
		<div class="mt-2 flex justify-center">
			<a class="button button-quiet" href={ passwordResetURL(oidcRequest) }>Forgot your password?</a>
		</div>
		<footer class="card-footer">
			<p class="text-muted">No account yet?</p>
			<a class="button button-secondary w-full sm:w-auto" href={ signupURL(oidcRequest) }>Create account</a>
		</footer>
	}
}

func signupURL(oidcRequest string) string {
	if oidcRequest == "" {
		return "/signup"
	}
	return "/signup?id=" + url.QueryEscape(oidcRequest)
}

func passwordResetURL(oidcRequest string) string {
	if oidcRequest == "" {
		return "/password-reset"
	}
	return "/password-reset?id=" + url.QueryEscape(oidcRequest)
}

templ passwordResetPage(message, oidcRequest string) {
	@layout("Reset your password", "") {
		@ui.Heading("Reset your password") {
			<p>We’ll email you a six-digit password reset code.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/password-reset">
			if oidcRequest != "" {
				<input type="hidden" name="oidc_request" value={ oidcRequest }/>
			}
			@ui.Field("email", "Email address", "", templ.Attributes{"type": "email", "name": "email", "autocomplete": "email", "autofocus": true, "required": true})
			<button class="button button-primary w-full" type="submit">Email me a reset code</button>
		</form>
		<p class="mt-6 text-muted"><a class="text-link" href="/login">Return to sign in</a>.</p>
	}
}

templ passwordResetCodePage(flow, message, oidcRequest string) {
	@layout("Enter your password reset code", "") {
		@ui.Heading("Check your email") {
			<p>If that address can be used, we sent a six-digit code. It expires in 15 minutes.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/password-reset/verify">
			<input type="hidden" name="flow" value={ flow }/>
			if oidcRequest != "" {
				<input type="hidden" name="oidc_request" value={ oidcRequest }/>
			}
			@ui.CodeField("Password reset code", true)
			<button class="button button-primary w-full" type="submit">Verify code</button>
		</form>
	}
}

templ newPasswordPage(flow, message string, passwordMinimumLength int, oidcRequest string) {
	@layout("Choose a new password", "") {
		@ui.Heading("Choose a new password") {
			<p>Use at least { strconv.Itoa(passwordMinimumLength) } characters. Changing your password signs out your other browser sessions on { siteFromContext(ctx).Name }.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/password-reset/complete">
			<input type="hidden" name="flow" value={ flow }/>
			if oidcRequest != "" {
				<input type="hidden" name="oidc_request" value={ oidcRequest }/>
			}
			@ui.Field("password", "New password", "", templ.Attributes{"type": "password", "name": "password", "autocomplete": "new-password", "minlength": strconv.Itoa(passwordMinimumLength), "maxlength": "1024", "autofocus": true, "required": true})
			<button class="button button-primary w-full" type="submit">Reset password</button>
		</form>
	}
}

templ passwordResetCompletePage() {
	@layout("Password reset", "") {
		@ui.Heading("Your password was reset") {
			<p>Your new password is ready. Sign in to continue.</p>
		}
		<a class="button button-primary mt-6" href="/login">Sign in</a>
	}
}

templ emailChangePage(message, signedInAs string) {
	@layout("Change your email address", signedInAs) {
		@ui.Heading("Change your email address") {
			<p>Enter your current password, then verify the new address. This signs out your other browser sessions on { siteFromContext(ctx).Name }.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/account/email">
			@ui.Field("email", "New email address", "", templ.Attributes{"type": "email", "name": "email", "autocomplete": "email", "autofocus": true, "required": true})
			@ui.Field("password", "Current password", "", templ.Attributes{"type": "password", "name": "password", "autocomplete": "current-password", "maxlength": "1024", "required": true})
			<button class="button button-primary w-full" type="submit">Email me a change code</button>
		</form>
	}
}

templ emailChangeCodePage(flow, message, signedInAs string) {
	@layout("Verify your new email address", signedInAs) {
		@ui.Heading("Check your new email address") {
			<p>We sent a six-digit code. It expires in 15 minutes.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/account/email/verify">
			<input type="hidden" name="flow" value={ flow }/>
			@ui.CodeField("Email change code", true)
			<button class="button button-primary w-full" type="submit">Verify code</button>
		</form>
	}
}

templ emailChangeConfirmPage(flow, message, signedInAs string) {
	@layout("Confirm your email change", signedInAs) {
		@ui.Heading("Your new email address is verified") {
			<p>Confirming will change your sign-in address and sign out your other browser sessions on { siteFromContext(ctx).Name }.</p>
		}
		@ui.Error(message)
		<form class="mt-6" method="post" action="/account/email/complete">
			<input type="hidden" name="flow" value={ flow }/>
			<button class="button button-primary w-full" type="submit">Change email address</button>
		</form>
	}
}

templ consentPage(request oidcprovider.ConsentRequest, signedInAs, accountID string, profile accounts.Profile) {
	@documentLayout("Authorize access", signedInAs, false, true) {
		@ui.Heading("Authorize " + request.ClientName + "?") {
			<p>
				if request.ClientHost == "configured by this site’s operator" {
					This application is configured by this site’s operator.
				} else {
					Application from <strong class="font-medium">{ request.ClientHost }</strong>.
				}
			</p>
		}
		<section class="mt-4" aria-labelledby="permissions-heading">
			<h2 id="permissions-heading" class="font-medium">You’ll share with { request.ClientName }</h2>
			<ul class="mt-2 divide-y divide-line border-y border-line">
				<li class="py-2">
					<details class="disclosure">
						<summary>Your account ID <span class="font-normal text-muted">(view)</span></summary>
						<code class="mt-2 block break-all text-muted">{ accountID }</code>
					</details>
				</li>
				if slices.Contains(request.Scopes, "profile") {
					<li class="py-2">
						<p><span class="font-medium">Username:</span> <span class="text-muted">{ profile.PreferredUsername }</span></p>
						if profile.FullName != "" {
							<p class="mt-1"><span class="font-medium">Full name:</span> <span class="text-muted">{ profile.FullName }</span></p>
						} else {
							<p class="mt-1 text-muted">Full name, if you add one</p>
						}
					</li>
				}
				if slices.Contains(request.Scopes, "email") {
					<li class="py-2">
						<p class="font-medium">Verified email address</p>
						<p class="mt-0.5 text-muted">{ signedInAs }</p>
					</li>
				}
			</ul>
		</section>
		<div class="mt-4 space-y-1 text-muted">
			if slices.Contains(request.Scopes, "profile") || slices.Contains(request.Scopes, "email") {
				<p>This access includes future changes to the information listed above.</p>
			}
			<p>You can revoke this access from your account page.</p>
		</div>
		<form class="mt-4 grid grid-cols-2 gap-3" method="post" action="/oidc/consent">
			<input type="hidden" name="consent_version" value={ strconv.FormatUint(uint64(authorizations.ConsentVersion), 10) }/>
			<input type="hidden" name="id" value={ request.ID }/>
			<button class="button button-secondary w-full px-3" type="submit" name="decision" value="deny">Deny</button>
			<button class="button button-primary w-full px-3" type="submit" name="decision" value="allow">Authorize</button>
		</form>
	}
}

templ signupPage(message, oidcRequest string) {
	@layout("Create your account", "") {
		@ui.Heading("Create your account") {
			<p>We’ll email you a six-digit verification code.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/signup">
			if oidcRequest != "" {
				<input type="hidden" name="oidc_request" value={ oidcRequest }/>
			}
			@ui.Field("email", "Email address", "", templ.Attributes{"type": "email", "name": "email", "autocomplete": "email", "required": true})
			<button class="button button-primary w-full" type="submit">Email me a code</button>
		</form>
	}
}

templ codePage(flow, message, oidcRequest string) {
	@layout("Verify your email", "") {
		@ui.Heading("Check your email") {
			<p>If that address can be used, we sent a six-digit code. It expires in 15 minutes.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/signup/verify">
			if oidcRequest != "" {
				<input type="hidden" name="oidc_request" value={ oidcRequest }/>
			}
			<input type="hidden" name="flow" value={ flow }/>
			@ui.CodeField("Verification code", true)
			<button class="button button-primary w-full" type="submit">Verify email</button>
		</form>
	}
}

templ passwordPage(flow, message string, passwordMinimumLength int, oidcRequest string) {
	@layout("Choose a password", "") {
		@ui.Heading("Choose a password") {
			<p>Use at least { strconv.Itoa(passwordMinimumLength) } characters. Spaces and passphrases are welcome.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/signup/complete">
			if oidcRequest != "" {
				<input type="hidden" name="oidc_request" value={ oidcRequest }/>
			}
			<input type="hidden" name="flow" value={ flow }/>
			@ui.Field("password", "Password", "", templ.Attributes{"type": "password", "name": "password", "autocomplete": "new-password", "minlength": strconv.Itoa(passwordMinimumLength), "maxlength": "1024", "required": true})
			@ui.Field("password_confirmation", "Confirm password", "", templ.Attributes{"type": "password", "name": "password_confirmation", "autocomplete": "new-password", "minlength": strconv.Itoa(passwordMinimumLength), "maxlength": "1024", "required": true})
			<button class="button button-primary w-full" type="submit">Create account</button>
		</form>
	}
}

templ accountCreatedPage(accountID string) {
	@layout("Account created", "") {
		@ui.Heading("Your account is ready") {
			<p>Your email was verified and your account was created.</p>
		}
		<p class="mt-6 text-muted">Account ID: <code>{ accountID }</code></p>
		<a class="button button-primary mt-6" href="/login">Sign in</a>
	}
}

templ accountPage(accountID, signedInAs string, browserSessions []sessions.BrowserSession, authorizationGrants []authorizations.Grant, passwordChanged, emailChanged, profileUpdated, notificationFailed, sessionRevoked, otherSessionsRevoked, sessionMissing, appRevoked, appMissing, administrator bool) {
	@pageLayout("Your account", signedInAs, true, administrator) {
		@ui.Heading("Your account") {
			<p>Manage your profile, security, and connected apps.</p>
		}
		if passwordChanged {
			@ui.Notice(ui.Success) {
				<p>Your password was changed. Your other browser sessions on { siteFromContext(ctx).Name } were signed out.</p>
			}
		}
		if emailChanged {
			@ui.Notice(ui.Success) {
				<p>Your email address was changed. Use your new email address the next time you sign in.</p>
			}
		}
		if profileUpdated {
			@ui.Notice(ui.Success) {
				<p>Your profile was updated.</p>
			}
		}
		if notificationFailed {
			@ui.Notice(ui.Warning) {
				<p>We couldn’t send a security notice to your previous address. Your email address was still changed.</p>
			}
		}
		if sessionRevoked {
			@ui.Notice(ui.Success) {
				<p>The other browser session was signed out.</p>
			}
		}
		if otherSessionsRevoked {
			@ui.Notice(ui.Success) {
				<p>Your other browser sessions were signed out.</p>
			}
		}
		if sessionMissing {
			@ui.Notice(ui.Neutral) {
				<p>That browser session is no longer active.</p>
			}
		}
		if appRevoked {
			@ui.Notice(ui.Success) {
				<p>The app’s authorization was revoked. It must ask for access again in a future authorization flow.</p>
			}
		}
		if appMissing {
			@ui.Notice(ui.Neutral) {
				<p>That app is no longer authorized.</p>
			}
		}
		<section class="panel mt-6" aria-labelledby="profile-heading">
			<h2 id="profile-heading" class="settings-heading">Profile</h2>
			<p class="settings-description">Choose how you appear in connected apps.</p>
			<div class="settings-actions">
				<a class="settings-link" href="/account/profile"><span>Edit profile</span><span aria-hidden="true">›</span></a>
				<a class="settings-link" href="/account/email"><span>Change email address</span><span aria-hidden="true">›</span></a>
			</div>
			<p class="mt-4 break-all text-muted">Account ID: <code>{ accountID }</code></p>
		</section>
		<section class="panel mt-6" aria-labelledby="security-heading">
			<h2 id="security-heading" class="settings-heading">Security</h2>
			<p class="settings-description">Keep your sign-in details up to date.</p>
			<div class="settings-actions">
				<a class="settings-link" href="/account/password"><span>Change password</span><span aria-hidden="true">›</span></a>
			</div>
		</section>
		<section class="panel mt-6">
			<h2 class="settings-heading">Connected apps</h2>
			<p class="settings-description">Apps you allowed to access your { siteFromContext(ctx).Name } account. Each app can read the information listed below. Revoking access makes the app ask again next time. It does not sign you out of the app or invalidate tokens it already has.</p>
			if len(authorizationGrants) == 0 {
				<p class="mt-4 text-muted">You haven’t authorized any apps yet.</p>
			} else {
				<div class="mt-5 space-y-3">
					for _, grant := range authorizationGrants {
						<div class="settings-item">
							<div class="flex flex-col items-start gap-4 sm:flex-row sm:justify-between">
								<div class="min-w-0">
									<p class="font-semibold">{ grant.ClientName }</p>
									<p class="mt-1 break-words text-muted">{ grant.ClientHost }</p>
									<p class="mt-2 text-muted">Account ID
										if slices.Contains(grant.Scopes, "profile") {
											<span>, username and full name</span>
										}
										if slices.Contains(grant.Scopes, "email") {
											<span>, verified email address</span>
										}
									</p>
									<p class="mt-2 text-muted">Authorized { formatSessionTime(grant.AuthorizedAt) }</p>
								</div>
								<form class="w-full sm:w-auto" method="post" action="/account/authorizations/revoke">
									<input type="hidden" name="grant_id" value={ grant.ID }/>
									<button class="button button-danger button-compact w-full whitespace-nowrap sm:w-auto" type="submit">Revoke access</button>
								</form>
							</div>
						</div>
					}
				</div>
			}
		</section>
		<section class="panel mt-6">
			<h2 class="settings-heading">Sessions</h2>
			<p class="settings-description">Review your sign-ins on { siteFromContext(ctx).Name }. We do not store browser names, IP addresses, or locations.</p>
			<div class="mt-5 space-y-3">
				for _, browserSession := range browserSessions {
					<div class="settings-item">
						<div class="flex flex-col items-start gap-4 sm:flex-row sm:justify-between">
							<div>
								<div class="flex flex-wrap items-center gap-2">
									<p class="font-semibold">Browser session</p>
									if browserSession.Current {
										@ui.Badge("This browser")
									}
								</div>
								<dl class="mt-2 space-y-1 text-muted">
									<div><dt class="inline">Started:</dt><dd class="ml-1 inline">{ formatSessionTime(browserSession.CreatedAt) }</dd></div>
									<div><dt class="inline">Last active:</dt><dd class="ml-1 inline">{ formatSessionTime(browserSession.LastSeenAt) }</dd></div>
									<div><dt class="inline">Expires:</dt><dd class="ml-1 inline">{ formatSessionTime(browserSession.ExpiresAt) }</dd></div>
								</dl>
							</div>
							if !browserSession.Current {
								<form class="w-full sm:w-auto" method="post" action="/account/sessions/revoke">
									<input type="hidden" name="session_id" value={ browserSession.ID }/>
									<button class="button button-danger button-compact w-full whitespace-nowrap sm:w-auto" type="submit">Sign out</button>
								</form>
							}
						</div>
					</div>
				}
			</div>
			if hasOtherBrowserSession(browserSessions) {
				<form class="mt-4" method="post" action="/account/sessions/revoke-others">
					<button class="button button-danger w-full" type="submit">Sign out all other browsers</button>
				</form>
			}
		</section>
		<section class="panel mt-6" aria-labelledby="delete-heading">
			<h2 id="delete-heading" class="settings-heading">Delete account</h2>
			<p class="settings-description">Permanently close your account on { siteFromContext(ctx).Name }.</p>
			<a class="button button-danger button-compact mt-4" href="/account/delete">Delete account</a>
		</section>
		<form class="mt-6" method="post" action="/logout">
			<button class="button button-secondary button-compact" type="submit">Sign out</button>
		</form>
	}
}

func hasOtherBrowserSession(browserSessions []sessions.BrowserSession) bool {
	for _, browserSession := range browserSessions {
		if !browserSession.Current {
			return true
		}
	}
	return false
}

func formatSessionTime(value time.Time) string {
	return value.UTC().Format("2 Jan 2006, 15:04 UTC")
}

templ profilePage(profile accounts.Profile, message, signedInAs string) {
	@layout("Edit your profile", signedInAs) {
		@ui.Heading("Edit your profile") {
			<p>Connected apps with profile access can see your username and full name. Other people can use the same names.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/account/profile">
			@ui.Field("preferred_username", "Preferred username", "This does not have to be unique.", templ.Attributes{"type": "text", "name": "preferred_username", "autocomplete": "username", "minlength": "2", "maxlength": "64", "value": profile.PreferredUsername, "autofocus": true, "required": true})
			@ui.Field("full_name", "Full name", "", templ.Attributes{"type": "text", "name": "full_name", "autocomplete": "name", "maxlength": "128", "value": profile.FullName})
			<button class="button button-primary w-full" type="submit">Save profile</button>
		</form>
		<p class="mt-6"><a class="text-link" href="/account">Return to your account</a>.</p>
	}
}

templ passwordChangePage(message string, passwordMinimumLength int, signedInAs string) {
	@layout("Change your password", signedInAs) {
		@ui.Heading("Change your password") {
			<p>Enter your current password and choose a new one. This signs out your other browser sessions on { siteFromContext(ctx).Name }.</p>
		}
		@ui.Error(message)
		<form class="form-stack" method="post" action="/account/password">
			@ui.Field("current_password", "Current password", "", templ.Attributes{"type": "password", "name": "current_password", "autocomplete": "current-password", "maxlength": "1024", "autofocus": true, "required": true})
			@ui.Field("new_password", "New password", "", templ.Attributes{"type": "password", "name": "new_password", "autocomplete": "new-password", "minlength": strconv.Itoa(passwordMinimumLength), "maxlength": "1024", "required": true})
			@ui.Field("new_password_confirmation", "Confirm new password", "", templ.Attributes{"type": "password", "name": "new_password_confirmation", "autocomplete": "new-password", "minlength": strconv.Itoa(passwordMinimumLength), "maxlength": "1024", "required": true})
			<button class="button button-primary w-full" type="submit">Change password</button>
		</form>
		<p class="mt-6"><a class="text-link" href="/account">Return to your account</a>.</p>
	}
}

templ deleteAccountPage(message string) {
	@layout("Delete account", "") {
		@ui.Heading("Delete your account")
		<p class="mt-4 leading-7">This cannot be undone. You will be signed out of { siteFromContext(ctx).Name } on every device. Your private account details will become unreadable when background key erasure finishes. Encrypted history and basic audit records remain.</p>
		<p class="mt-4 leading-7">This does not delete your data or end sessions in other apps. Those apps may still accept identity tokens already issued by { siteFromContext(ctx).Name } until they expire.</p>
		<p class="mt-4 leading-7">Short-lived verification records expire separately. Backup copies follow the operator’s retention policy. You can sign up again with the same email address, but you will get a new account ID.</p>
		@ui.Error(message)
		<form class="form-stack" method="post" action="/account/delete">
			@ui.Field("password", "Current password", "", templ.Attributes{"type": "password", "name": "password", "autocomplete": "current-password", "maxlength": "1024", "required": true})
			<label class="flex items-start gap-3"><input class="mt-1" type="checkbox" name="confirm" value="delete" required/><span>I understand that this permanently deletes my account on { siteFromContext(ctx).Name }.</span></label>
			<button class="button button-danger w-full" type="submit">Permanently delete account</button>
			<a class="button button-secondary w-full" href="/account">Keep my account</a>
		</form>
	}
}

templ accountDeletedPage() {
	@layout("Account deleted", "") {
		@ui.Heading("Your account is closed")
		<p class="mt-4 leading-7">You can no longer sign in to { siteFromContext(ctx).Name } with this account. We will finish removing access to your private account details automatically.</p>
		<a class="button button-secondary mt-6 w-full" href="/">Return home</a>
	}
}
