{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "alpha.1",
  "separate-pull-requests": true,
  "draft": true,
  "force-tag-creation": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "chatto",
      "prerelease-type": "beta.1",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "authling",
        "examples/botto",
        "experimental",
        "packages/runling",
        "packages/chattobot",
        "pnpm-lock.yaml",
        "pkg/appconfig",
        "pkg/datacrypto",
        "pkg/events",
        "pkg/jetstreamutil",
        "pkg/natsruntime",
        ".agents/skills",
        "packages/translatto"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "packages/chatto-client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "cli/version.go"
        },
        {
          "type": "json",
          "path": "apps/frontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "authling": {
      "package-name": "authling",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0-alpha.1",
      "draft": true,
      "include-component-in-tag": true,
      "tag-separator": "/",
      "extra-files": [
        {
          "type": "generic",
          "path": "version.go"
        }
      ]
    },
    "packages/runling": {
      "release-type": "simple",
      "package-name": "runling",
      "component": "runling",
      "versioning": "default",
      "prerelease": false,
      "draft": true,
      "include-component-in-tag": true,
      "tag-separator": "/",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "pkg/appconfig": {
      "release-type": "go",
      "package-name": "appconfig",
      "component": "pkg/appconfig",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0-alpha.1",
      "draft": true,
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "pkg/datacrypto": {
      "release-type": "go",
      "package-name": "datacrypto",
      "component": "pkg/datacrypto",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0-alpha.1",
      "draft": true,
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "pkg/jetstreamutil": {
      "release-type": "go",
      "package-name": "jetstreamutil",
      "component": "pkg/jetstreamutil",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0-alpha.1",
      "draft": true,
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "pkg/events": {
      "release-type": "go",
      "package-name": "events",
      "component": "pkg/events",
      "versioning": "default",
      "prerelease": false,
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "draft": true,
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "pkg/natsruntime": {
      "release-type": "go",
      "package-name": "natsruntime",
      "component": "pkg/natsruntime",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0-alpha.1",
      "draft": true,
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "packages/translatto": {
      "release-type": "simple",
      "package-name": "translatto",
      "component": "translatto",
      "versioning": "default",
      "prerelease": false,
      "draft": true,
      "include-component-in-tag": true,
      "tag-separator": "/",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ],
      "initial-version": "0.1.1"
    }
  }
}
