{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatto.chat/schema/interchange/v1/common.schema.json",
  "description": "Shared values for the draft Chatto interchange format.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u0020\\u007f]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "nullableTimestamp": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "properties": {
        "format": {
          "const": "chatto-markdown"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["format", "text"],
      "additionalProperties": false
    },
    "content": {
      "description": "Readable content, unavailable content, or a native tombstone. Deleted content has no body or asset references.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "available"
            },
            "body": {
              "$ref": "common.schema.json#/$defs/body"
            },
            "asset_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "uniqueItems": true
            }
          },
          "required": ["status", "body", "asset_ids"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": ["not_exported", "not_retained", "access_denied", "unknown"]
            }
          },
          "required": ["status", "reason"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "deleted"
            }
          },
          "required": ["status"],
          "additionalProperties": false
        }
      ]
    },
    "reaction": {
      "type": "object",
      "properties": {
        "emoji": {
          "type": "string",
          "minLength": 1,
          "description": "Unicode emoji sequence or case-sensitive reaction name (1–128 ASCII letters, digits, underscores, plus signs, or hyphens; no colons)."
        },
        "user_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["emoji", "user_ids"],
      "additionalProperties": false
    }
  }
}
