{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "alpha.1",
  "always-update": true,
  "separate-pull-requests": true,
  "draft": true,
  "force-tag-creation": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "chatto",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "authling",
        "pkg/events",
        ".agents/skills"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "cli/version.go"
        },
        {
          "type": "json",
          "path": "apps/frontend/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "authling": {
      "package-name": "authling",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0-alpha.1",
      "draft": false,
      "include-component-in-tag": true,
      "tag-separator": "/",
      "extra-files": [
        {
          "type": "generic",
          "path": "version.go"
        }
      ]
    },
    "pkg/events": {
      "release-type": "go",
      "package-name": "events",
      "component": "pkg/events",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0-alpha.1",
      "draft": false,
      "include-component-in-tag": true,
      "tag-separator": "/"
    }
  }
}
