package web

import (
	"github.com/chattocorp/chatto/authling/internal/accounts"
	"github.com/chattocorp/chatto/authling/internal/web/ui"
)

templ administrationPage(signedInAs string, rows []accounts.RegisteredAccount, configured bool, view directoryView, more bool) {
	@administrationWorkspace(signedInAs, "users") {
		<div class="panel">
			@ui.SectionHeading("Registered users") {
				<p>Accounts registered with { siteFromContext(ctx).Name }.</p>
			}
			<div class="mt-6">
				@ui.SortableDataTable("Registered users", []ui.Column{
					{Label: "Email"},
					{Label: "Name"},
					view.column("Access", accounts.SortByAccess),
					view.column("Registered", accounts.SortByRegistered),
					view.column("Account ID", accounts.SortByID),
				}) {
					if len(rows) == 0 {
						@ui.TableEmpty(5, "No accounts on this page.")
					}
					for _, row := range rows {
						<tr id={ "account-" + row.ID } class="whitespace-nowrap">
							<th scope="row" class="font-medium">{ row.EmailHint }</th>
							<td>{ row.NameHint }</td>
							<td>
								if row.Access.Allowed() {
									if row.Access.Configured {
										<span title="Via server configuration">@ui.Badge("Administrator")
</span>
									} else {
										@ui.Badge("Administrator")
									}
								} else {
									<span class="text-muted">User</span>
								}
							</td>
							<td class="whitespace-nowrap tabular-nums">
								<time datetime={ row.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") } title={ row.CreatedAt.UTC().Format("02 Jan 2006 15:04 UTC") }>
									{ row.CreatedAt.UTC().Format("02 Jan 2006") }
								</time>
							</td>
							<td><code class="block max-w-28 truncate text-muted" title={ row.ID }>{ row.ID }</code></td>
						</tr>
					}
					if next := view.nextPageURL(more); next != "" {
						@ui.TableLoadMore(5, next, "Load more users")
					}
				}
			</div>
			@ui.Pagination(view.firstPageURL(), "")
			if configured {
				<p class="mt-5 text-muted">Your administrator access is set in server configuration.</p>
			}
		</div>
	}
}
