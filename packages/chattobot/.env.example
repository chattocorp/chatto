CHATTO_URL=http://localhost:8080
CHATTO_API_KEY=
# Optional: respond only to this exact Chatto user ID (not a display name).
# Unset or empty allows all users. Restart after changing this setting.
# CHATTO_ALLOWED_USER_ID=U...
CHATTO_AGENT_MODEL=openrouter/google/gemma-4-26b-a4b-it
# Shared by all agents that use an openrouter/ model. No Pi login required.
# Restart the bot after changing .env. An existing shell variable takes precedence.
# OPENROUTER_API_KEY=
# Optional read-only source investigation (use a trusted or isolated host):
# CHATTO_SOURCE_DIRECTORY=/absolute/path/to/chatto
# CHATTO_SOURCE_REF=origin/main
# CHATTO_INVESTIGATION_MODEL=openrouter/z-ai/glm-5.3-flash
# Optional implementation and GitHub publication. Requires matching origin,
# Git author configuration, Git push access, and authenticated gh CLI.
# CHATTO_IMPLEMENTATION_REPOSITORY=owner/repo
# CHATTO_IMPLEMENTATION_MODEL=openrouter/z-ai/glm-5.3-flash
