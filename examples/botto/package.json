{
  "name": "@chatto/example-botto",
  "version": "0.1.0",
  "private": true,
  "description": "A Chatto conversation bot hosted by Runling",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "runling serve --host 127.0.0.1",
    "dev": "tsx watch --include './src/**/*.ts' --include './runling.config.ts' --include './botto.toml' --include './.env' node_modules/runling/bin/runling.js serve --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chatto/api-types": "workspace:*",
    "@chatto/client": "workspace:*",
    "@connectrpc/connect": "^1.7.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "sharp": "^0.35.4",
    "smol-toml": "^1.6.1",
    "runling": "workspace:*",
    "tsx": "^4.20.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  }
}
