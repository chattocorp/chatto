{
  "name": "@chatto/example-botto",
  "version": "0.1.0",
  "private": true,
  "description": "A Chatto conversation bot built directly on the Pi SDK",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chatto/api-types": "workspace:*",
    "@chatto/client": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "smol-toml": "^1.6.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  }
}
