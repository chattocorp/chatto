{
  "name": "chatto-frontend",
  "private": true,
  "version": "0.4.8",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm check:bundle",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "pnpm run check:design-system && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test:unit:run": "vitest --run --project=server && vitest --run --project=client && vitest --run --project=storybook && pnpm run test:performance-comparison",
    "test:performance-comparison": "node --test scripts/compare-e2e-performance.test.mjs",
    "test:storybook": "vitest --project=storybook",
    "test": "pnpm run test:unit:run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm --filter @chatto/api-types build && pnpm --filter @chatto/lingua build && storybook build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify/json": "^2.2.518",
    "@iconify/tailwind4": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/sveltekit": "^10.5.10",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-code-block-lowlight": "3.30.2",
    "@tiptap/extension-link": "3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/markdown": "3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/linkify-it": "^5.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "highlight.js": "^11.12.0",
    "lowlight": "3.3.0",
    "markdown-it": "^14.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "sharp": "^0.34.5",
    "storybook": "^10.5.10",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-dnd-action": "^0.9.78",
    "svelte2tsx": "^0.7.61",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "virtua": "^0.48.8",
    "vite": "^8.2.2",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^2.2.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@chatto/api-types": "workspace:*",
    "@chatto/lingua": "workspace:*",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "@tanstack/svelte-query": "^6.1.38",
    "gemoji": "^8.1.0",
    "heic2any": "^0.0.4",
    "hls.js": "^1.7.1",
    "js-sha256": "^0.11.1",
    "linkify-it": "^5.0.2",
    "livekit-client": "^2.22.0",
    "semver": "^7.8.5",
    "tlds": "^1.261.0",
    "vidstack": "^1.15.6"
  }
}
