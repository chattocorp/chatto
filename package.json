{
  "name": "chatto-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "turbo": "node tools/turbo.mjs",
    "build:api-types": "pnpm turbo run build --filter=@chatto/api-types",
    "build:lingua": "pnpm turbo run build --filter=@chatto/lingua",
    "build:chatto-client": "pnpm turbo run build --filter=@chatto/client",
    "build:runling": "pnpm turbo run build --filter=runling",
    "check:runling": "pnpm turbo run check --filter=runling",
    "test:runling": "pnpm turbo run test --filter=runling",
    "build:docs": "pnpm turbo run build --filter=docs-website",
    "build:frontend": "pnpm turbo run build --filter=chatto-frontend",
    "build:storybook": "pnpm turbo run build-storybook --filter=chatto-frontend",
    "check": "pnpm turbo run check --concurrency=1",
    "check:frontend": "pnpm turbo run check --filter=chatto-frontend",
    "dev:docs": "mise dev-docs-website",
    "dev:frontend": "pnpm turbo run dev --filter=chatto-frontend",
    "knip": "pnpm run knip:prepare && knip",
    "knip:prepare": "pnpm turbo run prepare --filter=chatto-frontend",
    "lint": "pnpm turbo run lint --concurrency=1",
    "lint:frontend": "pnpm turbo run lint --filter=chatto-frontend",
    "test": "pnpm turbo run test --concurrency=1",
    "test:lingua": "pnpm turbo run test --filter=@chatto/lingua",
    "test:frontend": "pnpm turbo run test --filter=chatto-frontend"
  },
  "devDependencies": {
    "knip": "^6.22.0",
    "turbo": "2.11.2"
  }
}
