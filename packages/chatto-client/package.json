{
  "name": "@chatto/client",
  "version": "0.5.0-beta.23",
  "description": "Framework-neutral Chatto client: connections, realtime projection, and reactive stores",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./src/svelte/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./svelte": "./src/svelte/index.ts",
    "./reactivity": "./src/reactivity/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test:package": "node scripts/test-package.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.strict.json && node scripts/generate-types.mjs --check && node --test scripts/check-release.test.mjs",
    "test": "vitest run --coverage",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chattocorp/chatto.git",
    "directory": "packages/chatto-client"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "directory": "dist",
    "linkDirectory": false
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@chatto/api-types": "workspace:*",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "gemoji": "^8.1.0",
    "js-sha256": "^1.0.0",
    "lru-cache": "^11.5.1",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "svelte": "^5.7.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.10"
  }
}
