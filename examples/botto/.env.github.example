# Copy these entries into .env. Do not replace existing model or Chatto settings.
BOTTO_GITHUB_MCP_COMMAND=/absolute/path/to/github-mcp-server
BOTTO_GITHUB_APP_ID=replace-with-app-or-client-id
BOTTO_GITHUB_APP_INSTALLATION_ID=replace-with-installation-id
BOTTO_GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/examples/botto/github-app.pem
