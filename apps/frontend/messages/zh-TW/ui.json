      "points": "{count} 點",
      "laser_guns": [
        {
          "declarations": ["input count", "local countPlural = count: plural"],
          "selectors": ["countPlural"],
          "match": {
            "countPlural=one": "{count} 把雷射槍",
            "countPlural=other": "{count} 把雷射槍"
          }
        }
      ],
      "laser_ready": "雷射 {number}，威力 {power}，已就緒",
