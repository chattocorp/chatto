{
  "name": "chatto-frontend",
  "private": true,
  "version": "0.5.0-beta.7",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build && pnpm check:bundle && pnpm check:csp",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "pnpm run check:design-system && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test:unit:run": "vitest --run --project=server && vitest --run --project=client && vitest --run --project=storybook && pnpm run test:performance-comparison && pnpm run test:e2e-sharding",
    "test:performance-comparison": "node --test scripts/compare-e2e-performance.test.mjs",
    "test:e2e-sharding": "node --test scripts/run-e2e-shard.test.mjs",
    "test:storybook": "vitest --project=storybook",
    "test": "pnpm run test:unit:run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify/json": "^2.2.533",
    "@iconify/tailwind4": "^1.2.3",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-svelte-csf": "^5.1.3",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/sveltekit": "^10.6.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/linkify-it": "^5.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "lowlight": "3.3.0",
    "markdown-it": "^14.3.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "storybook": "^10.6.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-dnd-action": "^0.9.79",
    "svelte2tsx": "^0.7.61",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "virtua": "^0.52.7",
    "vite": "^8.3.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^2.2.1",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@capacitor/core": "8.5.2",
    "@chatto/api-types": "workspace:*",
    "@chatto/lingua": "workspace:*",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "@tanstack/svelte-query": "^6.2.4",
    "gemoji": "^8.1.0",
    "heic2any": "^0.0.4",
    "hls.js": "^1.7.3",
    "js-sha256": "^1.0.0",
    "linkify-it": "^5.0.2",
    "livekit-client": "^2.22.3",
    "semver": "^7.8.5",
    "tlds": "^1.261.0",
    "vidstack": "^1.15.6"
  }
}
