{
  "worktree": {
    "setup": "mise setup"
  },
  "scripts": {
    "dev": {
      "type": "service",
      "command": "exec bash tools/paseo-dev.sh"
    },
    "dev-full": {
      "type": "service",
      "command": "exec mise run paseo-stack"
    },
    "mailpit": {
      "type": "service",
      "command": "exec mise run paseo-mailpit"
    },
    "livekit": {
      "type": "service",
      "command": "exec mise run paseo-livekit"
    },
    "storybook": {
      "type": "service",
      "command": "exec mise run paseo-storybook"
    },
    "docs-website": {
      "type": "service",
      "command": "exec mise run paseo-docs-website"
    },
    "authling": {
      "type": "service",
      "command": "exec mise --cd authling run paseo"
    }
  }
}
