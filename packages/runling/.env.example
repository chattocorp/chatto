# Chatto demo connection. Keep credentials in the ignored .env file.
CHATTO_URL=http://localhost:8080
CHATTO_API_KEY=

# Required for the planning and coordinator demos. Use an absolute path to a
# dedicated Chatto checkout. The planning demo updates its main branch.
CHATTO_WORKING_COPY=

# Optional model overrides. Configure provider credentials in Pi or .env.
# CHATTO_PLAN_MODEL=openai-codex/gpt-5.6-sol
# CHATTO_AGENT_MODEL=openai-codex/gpt-5.6-luna
