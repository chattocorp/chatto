package web

templ homePage() {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>Authling</title>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body class="min-h-screen">
			<main class="mx-auto flex min-h-screen max-w-2xl items-center px-6 py-16">
				<section class="w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-200/50 sm:p-12 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/20">
					<div class="mb-8 flex size-14 items-center justify-center rounded-2xl bg-authling-500 text-white shadow-lg shadow-authling-500/25">
						<span class="iconify uil--shield-check text-3xl" aria-hidden="true"></span>
					</div>
					<p class="mb-3 text-sm font-semibold tracking-widest text-authling-600 uppercase dark:text-authling-200">Authling</p>
					<h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Identity, under your control.</h1>
					<p class="mt-5 max-w-xl text-lg leading-8 text-slate-600 dark:text-slate-300">
						This Authling service is ready. Account creation and sign-in are coming next.
					</p>
				</section>
			</main>
		</body>
	</html>
}
