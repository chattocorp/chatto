# Release-only frontend image. The workflow builds apps/frontend/build once before
# invoking Docker, then this image only packages those static files.
FROM fholzer/nginx-brotli:v1.28.0

COPY apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/frontend/build /usr/share/nginx/html
# The entrypoint renders the SPA document into /var/run/chatto-frontend at
# startup, so the web root can stay read-only. Keep the build output as the
# template and remove it from the web root so that it is never served.
RUN mv /usr/share/nginx/html/200.html /usr/share/nginx/200.html.template \
    && rm -f /usr/share/nginx/html/200.html.br /usr/share/nginx/html/200.html.gz
COPY --chmod=755 docker/frontend-entrypoint.sh /usr/local/bin/frontend-entrypoint.sh
COPY LICENSES/Apache-2.0.txt /usr/share/doc/chatto-client/LICENSE
# Retain the MIT text for bundled third-party dependencies.
COPY LICENSES/MIT.txt /usr/share/doc/chatto-client/LICENSE.MIT
COPY NOTICE /usr/share/doc/chatto-client/NOTICE

EXPOSE 80
ENTRYPOINT ["/usr/local/bin/frontend-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
