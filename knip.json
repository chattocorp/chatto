{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "dependencies": "warn",
    "devDependencies": "warn",
    "files": "warn",
    "unlisted": "warn",
    "exports": "off",
    "types": "off",
    "enumMembers": "off",
    "namespaceMembers": "off",
    "duplicates": "warn"
  },
  "ignoreBinaries": ["mise", "playwright"],
  "ignoreDependencies": ["gemoji"],
  "workspaces": {
    ".": {
      "entry": ["tools/*.mjs"],
      "project": ["tools/**/*.mjs"]
    },
    "apps/frontend": {
      "entry": [
        "playwright.compat.config.ts",
        "e2e/remote-compatibility.compat.ts",
        "scripts/*.mjs"
      ],
      "project": [
        ".storybook/**/*.{css,js,ts}",
        "e2e/**/*.ts",
        "scripts/**/*.mjs",
        "src/**/*.{js,ts,svelte}"
      ],
      "ignoreDependencies": [
        "@iconify/json",
        "@iconify/tailwind4",
        "@fontsource-variable/ibm-plex-sans",
        "@fontsource/ibm-plex-mono",
        "svelte2tsx",
        "tailwindcss"
      ],
      "ignoreIssues": {
        "src/lib/i18n/messages.ts": ["exports", "types"],
        "src/lib/pb/**": ["exports", "types", "enumMembers"]
      }
    },
    "apps/docs-website": {
      "entry": [
        "src/custom.css",
        "src/routeData.ts",
        "src/generated/connectrpc-api/*.raw.mdx"
      ]
    },
    "apps/desktop": {
      "entry": ["preload.cjs", "scripts/*.mjs"],
      "project": ["**/*.{cjs,mjs}"],
      "ignoreBinaries": ["xcrun"]
    },
    "packages/api-types": {
      "ignoreDependencies": [
        "@bufbuild/protoc-gen-es",
        "@connectrpc/protoc-gen-connect-es"
      ]
    },
    "packages/lingua": {
      "entry": ["src/**/*.spec.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
